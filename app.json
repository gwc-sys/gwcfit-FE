{
  "expo": {
    "name": "PulseFit Gym SaaS",
    "slug": "pulsefit-gym-saas",
    "owner": "mahesh-raskar",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/pulsefit-logo.png",
    "userInterfaceStyle": "automatic",
    "scheme": "pulsefit",
    "web": {
      "favicon": "./assets/images/pulsefit-logo.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.pulsefit.gymsaas",
      "userInterfaceStyle": "automatic",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "LSApplicationQueriesSchemes": [
          "gpay",
          "bhim",
          "phonepe",
          "upi"
        ]
      }
    },
    "android": {
      "package": "com.pulsefit.gymsaas",
      "googleServicesFile": "./google-services.json",
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/pulsefit-logo.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      "expo-asset",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow PulseFit to protect your account session with Face ID."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PulseFit to scan attendance codes and provide camera-assisted workout tracking."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow PulseFit to count your steps and estimate walking distance."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PulseFit to select your gym payment QR from photos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "5ab9f289-25fa-4f24-bd66-4d388712c796"
      }
    }
  }
}
